# Copy to D:/Qt/Qt5.12.12/5.12.12/mingw73_32/mkspecs/features
# In *.pro file add CONFIG += QModbus
QMODBUS_SRC = "D:/Qt/Projects/QModbus"
QMODBUS_BIN = "D:/Qt/Projects/QModbus_BIN"

INCLUDEPATH += $${QMODBUS_SRC}
LIBS += -L$${QMODBUS_BIN}

CONFIG(debug, debug|release) {
    LIBS += -lQModbusd
}
else {
    LIBS += -lQModbus
    QMAKE_CXXFLAGS += -fno-strict-aliasing
}
